rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /scores_balloon/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['nickname', 'score', 'country', 'timestamp', 'dateKey', 'weekKey', 'monthKey'])
                    && request.resource.data.nickname is string
                    && request.resource.data.nickname.size() > 0
                    && request.resource.data.nickname.size() <= 20
                    && request.resource.data.score is int
                    && request.resource.data.score >= 0
                    && request.resource.data.dateKey is string
                    && request.resource.data.weekKey is string
                    && request.resource.data.monthKey is string;
      allow update, delete: if false;
    }
    match /scores_tetris/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['nickname', 'score', 'country', 'timestamp', 'dateKey', 'weekKey', 'monthKey'])
                    && request.resource.data.nickname is string
                    && request.resource.data.nickname.size() > 0
                    && request.resource.data.nickname.size() <= 20
                    && request.resource.data.score is int
                    && request.resource.data.score >= 0
                    && request.resource.data.dateKey is string
                    && request.resource.data.weekKey is string
                    && request.resource.data.monthKey is string;
      allow update, delete: if false;
    }
  }
}
